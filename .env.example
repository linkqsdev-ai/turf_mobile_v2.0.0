# Copy to .env.local (git-ignored) to point the app at a backend other than the
# production VPS, then fully reload the app. Use your computer's LAN address on
# a phone — "localhost" there means the phone itself.
#
# Inlined into the JavaScript bundle: never put a secret in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api
